# Carona Aí — Environment Variables
# Copy this file to .env and fill in your own values.
#
# ── Local dev (no Docker for backend) ─────────────────────────────────────────
# 1. Run the DB with:  docker compose up db -d
# 2. Run migrations:   cd backend && alembic upgrade head
# 3. Run the API:      cd backend && fastapi dev app/main.py
#
# ── Full Docker setup ──────────────────────────────────────────────────────────
# docker compose up --build
# (migrate service runs automatically before the backend starts)

# App
SECRET_KEY=your-super-secret-key-change-this-in-production
DEBUG=true

# Database
# Local (backend running outside Docker, DB in Docker on port 5433):
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/carona_ai
# Inside Docker (uncomment if overriding the docker-compose default):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/carona_ai

# OSRM (local Docker — uncomment osrm service in docker-compose.yml first)
OSRM_URL=http://localhost:5000
OSRM_MAX_DETOUR_METERS=3000
OSRM_MAX_DETOUR_SECONDS=900

# Email (leave empty to print tokens to console in dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@caronaai.com

# CORS — accepts JSON array OR comma-separated list of allowed origins
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]