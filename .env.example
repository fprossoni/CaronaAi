# Carona Aí — Environment Variables
# Copy this file to .env and fill in the values

# App
SECRET_KEY=your-super-secret-key-change-this-in-production
DEBUG=true

# Database (Supabase or local PostgreSQL)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/carona_ai

# OSRM (local Docker)
OSRM_URL=http://localhost:5000
OSRM_MAX_DETOUR_METERS=3000
OSRM_MAX_DETOUR_SECONDS=900

# Email (leave empty to use console output in dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@caronaai.com

# CORS (comma-separated list of allowed origins)
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]